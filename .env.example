# Copy to .env next to this file. pm2 loads it when it starts the app.

# Required in production: signs cookies, links and the login token.
# Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_KEY=

# The port Caddy proxies to.
PORT=3003

# Where the data lives. ops/reset.sh wipes both every night.
DATABASE_PATH=data/todoish.sqlite
STORAGE_PATH=data/storage
